# RE:GARDE 서버 환경변수 — 이 파일을 .env 로 복사해서 채우세요
# cp .env.example .env

# 필수 — OpenAI API 키
OPENAI_API_KEY=sk-...

# 세션 토큰 서명 키. 운영에서는 반드시 임의의 긴 문자열로 바꾸세요.
# (NODE_ENV=production 인데 기본값이면 서버가 기동을 거부합니다)
JWT_SECRET=change-me-to-a-long-random-string

# 포트 (기본 8787)
PORT=8787

# OpenAI 모델 — 상담·시세·사진 감정에 모두 실제 API를 사용합니다.
MODEL_CHAT=gpt-4.1-mini
MODEL_SEARCH=gpt-4.1-mini
MODEL_VISION=gpt-4.1-mini

# 누적 API 예산(USD). 초과하면 429 로 자동 차단됩니다.
BUDGET_USD=100

# 감정사 콘솔을 role 검사 없이 열어 둘지 (개발 기본 1, 운영 기본 0)
DEMO_ADMIN=1

# production 으로 두면 role 검사와 시크릿 검사가 강제됩니다
# NODE_ENV=production
